# Dark mode document
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --config-id dark --title "Dark Report" \
  --text "This is body text on a dark background." --output dark.pdf

# Report with an embedded chart image
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --config-id report --title "Analysis" \
  --text "See the chart below." --image ./chart.png --output analysis.pdf

# Multiple images
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --config-id default --title "Gallery" \
  --images ./chart.png,./chart.png --output gallery.pdf

# Text from a file
java -jar pdf-creator.jar --title "Report" \
  --text-file ./report.txt --output report.pdf

# Inline only (as before)
java -jar pdf-creator.jar --title "Note" \
  --text "Hello world" --output note.pdf

# Both — file body + CLI appendix
java -jar pdf-creator.jar --title "Report" \
  --text-file ./report.txt \
  --text "Appendix: approved by Jane." \
  --output report.pdf
```

The console output will now also tell you where the text came from:
```
Using config  : report
Output file   : report.pdf
Text source   : file (./report.txt) + inline --text

# Single page test
java -jar target/pdf-creator-1.0-SNAPSHOT.jar \
  --config-id default \
  --title "Status Update" \
  --author "Jane Doe" \
  --text-file test-single-page.txt \
  --output out-single.pdf

# Multi page test
java -jar target/pdf-creator-1.0-SNAPSHOT.jar \
  --config-id report \
  --title "Annual Technology Review" \
  --author "Engineering Team" \
  --text-file test-multi-page.txt \
  --output out-multi.pdf

# Try the compact preset — smaller font means more fits per page
java -jar target/pdf-creator-1.0-SNAPSHOT.jar \
  --config-id compact \
  --title "Annual Technology Review" \
  --text-file test-multi-page.txt \
  --output out-compact.pdf


  # Put your logo at assets/logo.png first, then:
java -jar target/pdf-creator-1.0-SNAPSHOT.jar \
  --template-id branded-invoice \
  --data-file data/branded-invoice-acme.json \
  --output branded-invoice.pdf

# Single bank statement
java -jar target/pdf-creator-1.0-SNAPSHOT.jar \
  --template-id bank-statement \
  --data-file data/statements/CUST-001.json \
  --output output/CUST-001-feb26.pdf

# Batch — all statements in the directory, 8 threads
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --batch \
  --template-id bank-statement \
  --data-dir data/statements/ \
  --output-dir output/statements/ \
  --threads 8

# Credit card statement (different template, same data shape)
java -jar target/pdf-creator-1.0-SNAPSHOT.jar \
  --template-id credit-card-statement \
  --data-file data/cards/CARD-001.json \
  --output output/CARD-001-feb26.pdf

# Incorporating Metadata 
java -jar target/pdf-creator-1.0-SNAPSHOT.jar \
  --title    "Q1 2026 Meeting Notes" \
  --author   "Jane Smith" \
  --subject  "Quarterly planning meeting summary" \
  --keywords "meeting notes Q1 2026 planning budget" \
  --creator  "Internal Planning Tool" \
  --text     "Key decisions: approved Q1 budget..." \
  --output   notes.pdf

# All text to stdout
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract --input report.pdf

# Pages 1-2, saved to file
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract --input out-single.pdf \
  --output report.txt --start-page 1 --end-page 2

# Normalised, no metadata header, flat output
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract --input out-single.pdf \
  --strip-whitespace --no-metadata --no-per-page

# Normalised, no metadata header, flat output, saved to file
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract --input out-compact.pdf \
  --strip-whitespace --no-metadata --no-per-page --output report-compact.txt

# All images to extracted-images/ (default dir)
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract-images --input statement.pdf

# JPEG, min 100x100, pages 1-3 only, custom output dir
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract-images \
  --input gallery.pdf --output-dir output/images/ \
  --img-format jpg --min-width 100 --min-height 100 \
  --start-page 1 --end-page 3

# Extract text from a password-protected PDF
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract \
  --input input/protected.pdf --password admin1234

# Extract images from a password-protected PDF
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract-images \
  --input inputs/protected_2.pdf --password admin1234 \
  --output-dir images/

# Merge
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --merge \
  --inputs inputs/jan.pdf,inputs/feb.pdf,inputs/march.pdf --output output/q1.pdf

# Merge with a password-protected input (empty string = no password)
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --merge \
  --inputs inputs/jan.pdf,inputs/protected.pdf --passwords ,admin1234 --output output/merged.pdf

# Split every 5 pages
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --split \
  --input report.pdf --every-n-pages 5 --output-dir split/

# Split into 4 equal parts
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --split \
  --input report.pdf --into-parts 4 --output-dir split/

# Split at explicit boundaries
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --split \
  --input report.pdf --page-ranges "1-3,4-6,7-10" --output-dir split/

# Discover printers
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --list-printers

# Print to default printer (shows dialog)
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --print --input report.pdf

# Silent batch print to a named printer
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --print --input report.pdf \
  --printer "HP LaserJet 400" --silent \
  --copies 2 --sides duplex-long --scaling shrink

# Print pages 2–5 of a protected PDF
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --print --input protected.pdf \
  --password secret --start-page 2 --end-page 5 --silent

java -jar target/pdf-creator-1.0-SNAPSHOT.jar --encrypt \
    --input output/hello.pdf \
    --output test-encrypted.pdf \
    --owner-password "ownerSecret" \
    --user-password "userSecret"

# Expected: Error: PDF is password-protected and no password was supplied
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract --input output/test-encrypted.pdf

# Encrypt with read-only preset (opens freely, no copy/modify)
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --encrypt \
    --input output/hello.pdf \
    --output test-readonly.pdf \
    --owner-password "ownerSecret" \
    --user-password "" \
    --preset read-only

# Verify it opens without any password:
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract --input test-readonly.pdf

# Encrypt with custom deny flags
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --encrypt \
    --input output/hello.pdf \
    --output output/test-printonly.pdf \
    --owner-password "ownerSecret" \
    --deny-copy \
    --deny-modify \
    --deny-annotations \
    --deny-fill-forms \
    --deny-accessibility \
    --deny-assemble

# Inspect security status
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --inspect-security --input output/hello.pdf
# Expected: Encrypted: NO

java -jar target/pdf-creator-1.0-SNAPSHOT.jar --inspect-security \
    --input output/test-printonly.pdf \
    --owner-password "ownerSecret" \

# Update permissions on an existing encrypted PDF
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --update-permissions \
    --input output/test-encrypted.pdf \
    --output output/test-updated-perms.pdf \
    --owner-password "ownerSecret" \
    --preset print-only

# Inspect the Permissions 
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --inspect-security \
    --input output/test-updated-perms.pdf \
    --owner-password "ownerSecret"
# Expected: Print: allowed, Accessibility: DENIED, Copy: DENIED

# Change Password 
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --change-password \
    --input output/test-encrypted.pdf \
    --output output/test-newpwd.pdf \
    --owner-password "ownerSecret" \
    --new-owner-password "newOwner99" \
    --new-user-password "newUser99"

# Check if old password is rejected or not 
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract --input output/test-newpwd.pdf --password "userSecret"
# Expected: Error: Incorrect password for PDF

# Decrypt Pdf
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --decrypt \
    --input output/test-encrypted.pdf \
    --output output/test-decrypted.pdf \
    --owner-password "ownerSecret"

java -jar target/pdf-creator-1.0-SNAPSHOT.jar --inspect-security --input output/test-decrypted.pdf
# Expected: Encrypted: NO

java -jar target/pdf-creator-1.0-SNAPSHOT.jar --extract --input output/test-decrypted.pdf
# Expected: text extracted with no password needed

# Generate a test keystore (one time):
keytool -genkeypair \
  -storepass changeit -storetype PKCS12 -alias myorg \
  -validity 365 -keyalg RSA -keysize 2048 \
  -dname "CN=MyOrg Statements, O=MyOrg, L=Chennai, ST=TN, C=IN" \
  -keystore myorg.p12

# Sign a Statement 
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --sign \
  --input output/out-single.pdf --output output/statement-signed.pdf \
  --keystore myorg.p12 --keystore-password changeit \
  --reason "Monthly Account Statement" --location "Chennai, India"

# Verify the Signature 
# With custom trust anchor (self-signed cert)
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --verify \
  --input output/statement-signed.pdf --truststore myorg-public.cer

# With JVM default trust (for commercially issued certs — no truststore needed)
java -jar pdf-creator.jar --verify --input statement-signed.pdf

# Export public cert to share with recipients:
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --export-cert \
  --keystore myorg.p12 --keystore-password changeit --output myorg-public.cer

# Batch generate + sign customer statements in one pass:
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --batch \
  --template-id bank-statement \
  --csv-file customers.csv \
  --output-dir statements/ \
  --threads 8 \
  --keystore myorg.p12 --keystore-password changeit \
  --reason "Monthly Account Statement - March 2026" \
  --tsa-url http://timestamp.digicert.com

# All pages → PNG at 150 DPI (default)
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --rasterize \
    --input statement.pdf \
    --output-dir statement-pages/

# Print quality PNG at 300 DPI
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --rasterize \
    --input statement.pdf \
    --output-dir statement-pages/ \
    --dpi 300

# Pages 1-3 → JPEG at 200 DPI, 90% quality
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --rasterize \
    --input output/out-compact.pdf \
    --output-dir output/previews/ \
    --format jpeg --dpi 200 --jpeg-quality 0.90 \
    --start-page 1 --end-page 3

# First page only as a thumbnail
java -jar target/pdf-creator-1.0-SNAPSHOT.jar --rasterize \
    --input output/out-multi.pdf \
    --output-dir output/thumbnails/ \
    --dpi 72 --start-page 1 --end-page 1 \
    --file-prefix thumb
