<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pdfcreator</groupId>
    <artifactId>pdf-creator</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <pdfbox.version>3.0.2</pdfbox.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!--
            BouncyCastle — required for AES-128 and AES-256 encryption in PDFBox 3.x.
            Without this, PDFBox falls back to RC4 even when key length 256 is requested.
            RC4 encryption (40-bit or 128-bit) works without this dependency.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!--
            BouncyCastle PKIX — required for CMS signing (CMSSignedDataGenerator,
            JcaSignerInfoGeneratorBuilder), certificate chain validation (PKIXParameters,
            CertPathBuilder), and RFC 3161 TSA timestamping (TimeStampRequestGenerator,
            TimeStampToken). bcprov (above) provides the crypto primitives;
            bcpkix provides the higher-level PKI/CMS layer.
            Both must be the same version.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!--
            BouncyCastle Util — contains org.bouncycastle.asn1.cms.* (Attribute,
            AttributeTable, CMSObjectIdentifiers etc.) used by PdfSigner when
            embedding TSA timestamp tokens into SignerInfo unsigned attributes.
            bcpkix depends on bcutil transitively, but Maven does not guarantee
            transitive deps appear on the compile classpath, so we declare it
            explicitly. Must be the same version as bcprov and bcpkix.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcutil-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!--
            PDFBox Preflight — PDF/A-1 validation engine. Separate artifact from pdfbox core.
            Must be the same version as pdfbox to avoid class incompatibilities.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>preflight</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!--
            PDFBox XMPBox — XMP metadata parsing and writing. Required by both preflight
            (to check PDF/A XMP identification schema) and by our PdfACompliance class
            (to write pdfaid:part and pdfaid:conformance fields).
            Declared explicitly to pin the version — preflight pulls it transitively
            but Maven does not guarantee transitive deps appear on the compile classpath.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>xmpbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!--
            JAXB API — removed from the JDK since Java 9, but still required at runtime
            by xmpbox internals. Without this, XMP metadata operations throw
            NoClassDefFoundError: javax/xml/bind/... at runtime on Java 17.
        -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Shade plugin: bundles all dependencies into a single fat JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.pdfcreator.PdfCreator</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Include test sources in the fat JAR so PdfCreatorTest is runnable -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>compile-tests</id>
                        <phase>compile</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
                                <compileSourceRoot>${project.basedir}/src/test/java</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
